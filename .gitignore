# Claude Code's local, personal settings — not shared project config
.claude/settings.local.json

# Secrets — belt and suspenders on top of web/ and api/'s own .gitignore
.env
.env.local
.env*.local
!.env.example
# frigate-relay/env (missing the leading dot) has been created by mistake
# before — Docker Compose won't auto-load it, but it's still a real secrets
# file that deserves to never land in git.
env

# Dependencies / build output, in case anything ever lives outside web/ or api/
node_modules/
dist/
.next/
*.tsbuildinfo

# Local Supabase CLI cache (created by `supabase projects`/`link` commands)
supabase/.temp/

# Python (frigate-relay/)
__pycache__/
*.pyc

# OS cruft
.DS_Store
*.log
