# Frigate's MQTT broker
MQTT_HOST=192.168.1.137
MQTT_PORT=1883

# Dedicated bird-relay login on the Mosquitto add-on -- not the "frigate" user
MQTT_USER=bird-relay
MQTT_PASSWORD=

# Must match Frigate's mqtt.topic_prefix
MQTT_TOPIC_PREFIX=frigate

# Skip submitting another bird for a camera again until this many minutes
# have passed since its last one
COOLDOWN_MINUTES=15

# Frigate's own HTTP API (usually the same host as the MQTT broker above)
FRIGATE_HOST=192.168.1.137
FRIGATE_PORT=5000

# The Twitcher API's base URL and the shared static secret for POST /ingest/frigate
API_BASE_URL=https://api.yourdomain.com
INGEST_SECRET=
