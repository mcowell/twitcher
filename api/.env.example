# Get your key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Clerk Secret Key -- from https://dashboard.clerk.com -> your app -> API Keys
# (same Clerk app as the web/ frontend)
CLERK_SECRET_KEY=

# Supabase project URL and service-role key -- from your Supabase project's
# Settings -> API. Service-role key bypasses RLS; this API is the only thing
# that ever talks to Supabase, so keep it out of the browser entirely.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Fastmail SMTP, used only to email admins when a new account signs up and
# needs approval. SMTP_USER is your Fastmail login (not necessarily the
# From address below); SMTP_PASSWORD is an app-specific password scoped to
# SMTP (Settings -> Password & Security -> App Passwords), not your account
# password. NOTIFICATION_FROM_EMAIL must be an address/alias already set up
# as sendable in Fastmail.
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_FROM_EMAIL=

# Comma-separated list of frontend origins allowed to call this API. Used
# both for CORS and as the JWT `authorizedParties` allowlist.
ALLOWED_ORIGINS=http://localhost:3000

# Port this server listens on
PORT=4000
